<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>نظام إدارة المسابقات التفاعلي</title>
  <style>
    :root {
      --bg: #0f172a;
      --card: #1e293b;
      --card-2: #162033;
      --text: #f8fafc;
      --text-muted: #94a3b8;
      --border: #334155;
      --primary: #3b82f6;
      --success: #10b981;
      --danger: #ef4444;
      --warning: #f59e0b;
      --cyan: #06b6d4;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: system-ui, -apple-system, "Segoe UI", Tahoma, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.5;
      padding: 16px;
    }

    .topbar {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      background: var(--card);
      border: 1px solid var(--border);
      padding: 12px 16px;
      border-radius: 12px;
      margin-bottom: 16px;
    }

    .topbar-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      align-items: center;
    }

    .badge {
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 0.82rem;
      background: var(--primary);
      color: #fff;
    }

    .badge.viewer {
      background: #475569;
    }

    button, input, select {
      font-family: inherit;
      font-size: 0.9rem;
      border-radius: 8px;
      border: 1px solid var(--border);
      padding: 7px 12px;
      background: var(--card-2);
      color: var(--text);
    }

    button {
      cursor: pointer;
      transition: opacity 0.15s ease;
    }

    button:hover:not(:disabled) { opacity: 0.9; }
    button:disabled { opacity: 0.45; cursor: not-allowed; }

    .btn-primary { background: var(--primary); border-color: var(--primary); color: #fff; }
    .btn-success { background: var(--success); border-color: var(--success); color: #fff; }
    .btn-danger { background: var(--danger); border-color: var(--danger); color: #fff; }
    .btn-warning { background: var(--warning); border-color: var(--warning); color: #0f172a; font-weight: 600; }
    .btn-cyan { background: var(--cyan); border-color: var(--cyan); color: #0f172a; font-weight: 600; }
    .btn-ghost { background: transparent; }

    .layout {
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: 16px;
    }

    @media (max-width: 900px) {
      .layout { grid-template-columns: 1fr; }
    }

    .panel {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 14px;
      margin-bottom: 16px;
    }

    .panel-title {
      font-size: 1rem;
      font-weight: 700;
      margin-bottom: 10px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .admin-only { display: inline-flex; }
    body.viewer-mode .admin-only { display: none !important; }

    .controls-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 12px;
      align-items: center;
    }

    .players-grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 8px;
    }

    .player-tile {
      background: var(--card-2);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 8px;
      text-align: center;
    }

    .player-tile.status-eliminated {
      opacity: 0.5;
      border-color: var(--danger);
    }

    .player-tile.status-winner {
      border-color: var(--warning);
      background: rgba(245, 158, 11, 0.12);
    }

    .player-tile.is-selector {
      outline: 2px solid var(--cyan);
    }

    .player-tile.is-target {
      outline: 2px solid var(--success);
    }

    .player-num { font-size: 0.78rem; color: var(--text-muted); }
    .player-name { font-weight: 700; margin: 2px 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .player-meta { font-size: 0.75rem; color: var(--text-muted); }

    .stage-box {
      background: var(--card-2);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 14px;
      margin-bottom: 12px;
    }

    .stage-meta {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 10px;
      font-size: 0.88rem;
      color: var(--text-muted);
    }

    .question-text {
      font-size: 1.15rem;
      font-weight: 700;
      margin: 10px 0;
    }

    .answer-box {
      display: none;
      margin-top: 8px;
      padding: 8px 12px;
      border-radius: 8px;
      background: rgba(16, 185, 129, 0.14);
      border: 1px solid var(--success);
    }

    .answer-box.visible { display: block; }

    .timer-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 10px 0;
    }

    .timer-num {
      font-size: 1.5rem;
      font-weight: 800;
      min-width: 48px;
      text-align: center;
    }

    .timer-num.urgent { color: var(--danger); }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
      margin-bottom: 10px;
    }

    .stat-card {
      background: var(--card-2);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 8px;
      text-align: center;
    }

    .stat-val { font-size: 1.15rem; font-weight: 700; }
    .stat-lbl { font-size: 0.75rem; color: var(--text-muted); }

    .winners-board {
      display: grid;
      gap: 8px;
    }

    .winner-slot {
      display: flex;
      justify-content: space-between;
      padding: 8px 12px;
      border-radius: 8px;
      background: var(--card-2);
      border: 1px solid var(--border);
    }

    .winner-slot.filled { border-color: var(--warning); }

    .logs-box {
      max-height: 200px;
      overflow-y: auto;
      background: var(--card-2);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 8px;
      font-size: 0.82rem;
    }

    .log-entry { padding: 4px 0; border-bottom: 1px solid rgba(148, 163, 184, 0.12); }

    .screens-list { display: grid; gap: 8px; margin-top: 8px; }
    .screen-card {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: var(--card-2);
      border: 1px solid var(--border);
      padding: 8px 10px;
      border-radius: 8px;
    }
    .screen-status.online { color: var(--success); font-size: 0.8rem; }

    .modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(2, 6, 23, 0.75);
      z-index: 50;
      align-items: center;
      justify-content: center;
      padding: 16px;
    }

    .modal.open { display: flex; }

    .modal-content {
      width: 100%;
      max-width: 720px;
      max-height: 90vh;
      overflow-y: auto;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 16px;
    }

    .settings-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 10px;
      margin: 12px 0;
    }

    .form-field { display: flex; flex-direction: column; gap: 4px; font-size: 0.84rem; }

    .archive-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      background: var(--card-2);
      border: 1px solid var(--border);
      padding: 8px 10px;
      border-radius: 8px;
      margin-bottom: 8px;
    }

    .shake-effect { animation: shake 0.3s ease; }
    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-6px); }
      75% { transform: translateX(6px); }
    }

    #confettiCanvas {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 100;
    }
  </style>
</head>
<body class="viewer-mode">
  <canvas id="confettiCanvas"></canvas>

  <header class="topbar">
    <div class="topbar-actions">
      <strong id="screenTitleTag">لوحة المسابقة المباشرة</strong>
      <span id="roleBadge" class="badge viewer">وضع الجمهور أولاً</span>
      <span id="deviceRoleTag" style="font-size:0.82rem; color:var(--text-muted);">جهاز مشاهدة</span>
    </div>
    <div class="topbar-actions">
      <button id="followBtn" class="btn-ghost" onclick="toggleFollowContest()">➕ متابعة</button>
      <span style="font-size:0.85rem;">المتابعون: <strong id="followersCount">0</strong></span>
      <button id="undoBtn" class="btn-ghost admin-only" onclick="undoAction()" disabled>↩️ تراجع</button>
      <button class="btn-ghost admin-only" onclick="openSettings()">⚙️ الإعدادات</button>
      <button id="toggleRoleBtn" class="btn-warning" onclick="handleRoleButton()">🔑 دخول المدير</button>
    </div>
  </header>

  <main class="layout">
    <section>
      <div class="panel">
        <div class="panel-title">
          <span>المتسابقون</span>
          <div class="admin-only" style="gap:6px;">
            <input type="text" id="playerNameInput" placeholder="اسم المتسابق..." />
            <button class="btn-primary" onclick="registerPlayer()">تسجيل</button>
            <button class="btn-danger" onclick="removeLastPlayer()">حذف الأخير</button>
          </div>
        </div>

        <div class="controls-row admin-only">
          <label style="font-size:0.82rem; display:flex; align-items:center; gap:4px;">
            <input type="checkbox" id="replaceNamesCheck" /> استبدال الكل عند الاستيراد
          </label>
          <input type="file" id="namesFileInput" accept=".txt,.csv" onchange="importNamesFromFile(event)" />
          <button class="btn-ghost" onclick="exportBackupJson()">⬇️ تصدير نسخة</button>
          <input type="file" id="backupFileInput" accept=".json" onchange="importBackupFromFile(event)" />
        </div>

        <div id="playersGrid" class="players-grid"></div>
      </div>

      <div class="panel admin-only">
        <div class="panel-title">مزامنة الأسماء من Google Sheets</div>
        <div class="controls-row">
          <input type="text" id="sheetsUrlInput" placeholder="رابط شيت جوجل أو CSV..." style="flex:1; min-width:200px;" />
          <input type="text" id="sheetsRangeInput" placeholder="النطاق (مثال A2:A20)" style="width:150px;" />
          <input type="number" id="sheetsIntervalInput" value="30" min="5" max="3600" style="width:85px;" title="فترة التحديث بالثواني" />
          <label style="font-size:0.82rem; display:flex; align-items:center; gap:4px;">
            <input type="checkbox" id="sheetsAutoSyncCheck" onchange="toggleGoogleSheetsAutoSync()" /> تلقائي
          </label>
          <button class="btn-primary" onclick="saveGoogleSheetsConfig(true)">حفظ</button>
          <button class="btn-cyan" onclick="syncNamesFromGoogleSheets(false)">مزامنة الآن</button>
        </div>
        <div id="sheetsSyncStatus" style="font-size:0.82rem; color:var(--text-muted);">لم يتم التزامن بعد</div>
      </div>
    </section>

    <aside>
      <div class="panel">
        <div class="panel-title">
          <span>منصة السؤال والتحكم</span>
          <div class="admin-only" style="gap:6px;">
            <select id="selectionModeSelect" onchange="changeSelectionMode()">
              <option value="random">اختيار عشوائي</option>
              <option value="manual">اختيار يدوي</option>
            </select>
            <select id="levelSelector">
              <option value="all">كل المستويات</option>
              <option value="easy">سهل</option>
              <option value="medium">متوسط</option>
              <option value="hard">صعب</option>
            </select>
            <button class="btn-primary" onclick="pickRandomTarget()">🎲 اختيار خصم</button>
          </div>
        </div>

        <div class="stage-box">
          <div class="stage-meta">
            <span>المختار: <strong id="currentSelectorLabel">غير محدد</strong></span>
            <span>الخصم: <strong id="currentTargetLabel">بانتظار الاختيار</strong></span>
          </div>

          <div class="timer-row">
            <span id="timerDisplay" class="timer-num">30</span>
            <button id="timerToggleBtn" class="btn-ghost admin-only" onclick="toggleTimer()">⏸️</button>
            <button class="btn-ghost" onclick="revealAnswer()">👁️ إظهار/إخفاء الإجابة</button>
          </div>

          <div id="activeQuestionText" class="question-text">لا يوجد سؤال نشط حالياً.</div>
          <div id="answerBox" class="answer-box">الإجابة: <strong id="activeAnswerText"></strong></div>
        </div>

        <div class="controls-row admin-only">
          <button class="btn-success" onclick="handleAnswer(true)">✅ إجابة صحيحة</button>
          <button class="btn-danger" onclick="handleAnswer(false)">❌ إجابة خاطئة</button>
          <button class="btn-warning" onclick="handlePass()">↷ اعتذار / تمرير</button>
          <button class="btn-ghost" onclick="broadcastFullState('يدوي')">🔄 مزامنة الشاشات</button>
        </div>
      </div>

      <div class="panel">
        <div class="panel-title">الإحصائيات والفائزون</div>
        <div class="stats-grid">
          <div class="stat-card"><div id="statTotalPlayers" class="stat-val">0</div><div class="stat-lbl">الإجمالي</div></div>
          <div class="stat-card"><div id="statAvailablePlayers" class="stat-val">0</div><div class="stat-lbl">متاح</div></div>
          <div class="stat-card"><div id="statEliminatedPlayers" class="stat-val">0</div><div class="stat-lbl">مستبعد</div></div>
          <div class="stat-card"><div id="statWinnersCount" class="stat-val">0/3</div><div class="stat-lbl">الفائزون</div></div>
        </div>
        <div id="winnersBoard" class="winners-board"></div>
      </div>

      <div class="panel admin-only">
        <div class="panel-title">
          <span>الشاشات المنفصلة</span>
          <div style="display:flex; gap:6px; align-items:center;">
            <input type="number" id="orderedScreensInput" value="2" min="1" max="12" style="width:65px;" />
            <button class="btn-ghost" onclick="updateOrderedScreensCount()">تحديث</button>
            <button class="btn-cyan" onclick="openAllOrderedScreens()">فتح الكل</button>
          </div>
        </div>
        <div id="orderedScreensList" class="screens-list"></div>
      </div>

      <div class="panel">
        <div class="panel-title">سجل الأحداث</div>
        <div id="logsContainer" class="logs-box"></div>
      </div>
    </aside>
  </main>

  <div id="loginModal" class="modal">
    <div class="modal-content" style="max-width:380px;">
      <h3 style="margin-bottom:10px;">دخول المدير</h3>
      <div class="form-field">
        <label for="loginPassInput">الرقم السري</label>
        <input type="password" id="loginPassInput" onkeydown="if(event.key==='Enter') verifyAdminLogin()" />
      </div>
      <div class="controls-row" style="margin-top:12px;">
        <button class="btn-primary" onclick="verifyAdminLogin()">دخول</button>
        <button class="btn-ghost" onclick="closeLoginModal()">إلغاء</button>
      </div>
    </div>
  </div>

  <div id="settingsModal" class="modal">
    <div class="modal-content">
      <div class="panel-title">
        <span>إعدادات المسابقة وأرشيف الأسئلة</span>
        <button class="btn-ghost" onclick="closeSettings()">✕</button>
      </div>

      <div class="settings-grid">
        <div class="form-field"><label>الإسقاطات للفوز</label><input type="number" id="cfgKillsToWin" min="1" max="50" /></div>
        <div class="form-field"><label>الحد الأقصى للفائزين</label><input type="number" id="cfgMaxWinners" min="1" max="100" /></div>
        <div class="form-field"><label>عدد اللاعبين</label><input type="number" id="cfgTotalPlayers" min="2" max="100" /></div>
        <div class="form-field"><label>عدد الأعمدة</label><input type="number" id="cfgCols" min="2" max="12" /></div>
        <div class="form-field"><label>الحد الأقصى للأخطاء</label><input type="number" id="cfgMaxErrors" min="1" max="20" /></div>
        <div class="form-field"><label>الحد الأقصى للاعتذار</label><input type="number" id="cfgMaxPasses" min="0" max="20" /></div>
        <div class="form-field"><label>مدة المؤقت (ثانية)</label><input type="number" id="cfgTimerSec" min="5" max="600" /></div>
        <div class="form-field"><label>عدد الشاشات المرتبة</label><input type="number" id="cfgOrderedScreens" min="1" max="12" /></div>
        <div class="form-field"><label>رابط المزامنة السحابية</label><input type="text" id="cfgCloudSyncUrl" placeholder="https://..." /></div>
      </div>

      <div class="controls-row">
        <button class="btn-success" onclick="saveSettings()">💾 حفظ الإعدادات</button>
        <input type="password" id="newAdminPass" placeholder="رقم سري جديد للمدير..." />
        <button class="btn-warning" onclick="changePassword()">تغيير الرقم السري</button>
      </div>

      <hr style="border-color:var(--border); margin:14px 0;" />

      <div class="panel-title">
        <span>أرشيف الأسئلة (<span id="archiveTotalCount">0</span>)</span>
        <select id="archiveFilterSelect" onchange="renderArchiveList()">
          <option value="all">الكل</option>
          <option value="easy">سهل</option>
          <option value="medium">متوسط</option>
          <option value="hard">صعب</option>
        </select>
      </div>

      <div class="settings-grid">
        <div class="form-field"><label>نص السؤال الجديد</label><input type="text" id="newQText" /></div>
        <div class="form-field"><label>الإجابة الصحيحة</label><input type="text" id="newQAnswer" /></div>
        <div class="form-field">
          <label>المستوى</label>
          <select id="newQLevel">
            <option value="easy">سهل</option>
            <option value="medium">متوسط</option>
            <option value="hard">صعب</option>
          </select>
        </div>
      </div>
      <button class="btn-primary" onclick="addQuestionToArchive()" style="margin-bottom:12px;">➕ إضافة سؤال للأرشيف</button>
      <div id="archiveListContainer"></div>
    </div>
  </div>

  <script>
    const DEFAULT_QUESTIONS = [
      { id: 1, text: "ما هي عاصمة سلطنة عُمان؟", answer: "مسقط", level: "easy" },
      { id: 2, text: "ما هو أطول نهر في العالم؟", answer: "نهر النيل", level: "easy" },
      { id: 3, text: "كم عدد كواكب المجموعة الشمسية؟", answer: "8 كواكب", level: "easy" },
      { id: 4, text: "ما هو العنصر الكيميائي الذي رمزه Au؟", answer: "الذهب", level: "medium" },
      { id: 5, text: "في أي قارة تقع جمهورية البرازيل؟", answer: "أمريكا الجنوبية", level: "easy" },
      { id: 6, text: "ما هو أسرع حيوان بري؟", answer: "الفهد (الشيتا)", level: "easy" },
      { id: 7, text: "من هو مؤلف كتاب المقدمة؟", answer: "ابن خلدون", level: "medium" },
      { id: 8, text: "ما هي أكبر محيطات العالم مساحة؟", answer: "المحيط الهادئ", level: "medium" },
      { id: 9, text: "كم عدد سور القرآن الكريم؟", answer: "114 سورة", level: "easy" },
      { id: 10, text: "ما هو الغاز الأكثر وفرة في الغلاف الجوي للأرض؟", answer: "النيتروجين", level: "hard" }
    ];

    const STORAGE_KEY = "contest_pro_sync_v2";
    const LOCAL_AUDIENCE_KEY = "contest_pro_local_audience_v2";
    const CHANNEL_NAME = "contest_pro_sync_channel_v2";
    const channel = ("BroadcastChannel" in window) ? new BroadcastChannel(CHANNEL_NAME) : null;

    // تجزئة SHA-256 للرقم السري الافتراضي ("1234")
    const DEFAULT_ADMIN_PASS_HASH = "03ac674216f3e15c761ee1a5e255f067953623c8b388b4459e13f978d7c846f4";

    let localAudienceState = loadLocalAudienceState();
    let state = loadState();
    let historyStack = [];
    let timerInterval = null;
    let timerEndPerf = null;
    let timerRemainingAtPause = null;
    let sheetsSyncTimer = null;
    let isAdmin = false;

    async function sha256Hex(text) {
      if (window.crypto && window.crypto.subtle) {
        const enc = new TextEncoder();
        const buf = await window.crypto.subtle.digest("SHA-256", enc.encode(String(text)));
        return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2, "0")).join("");
      }
      let h = 2166136261;
      const s = String(text);
      for (let i = 0; i < s.length; i++) {
        h ^= s.charCodeAt(i);
        h = Math.imul(h, 16777619);
      }
      return (h >>> 0).toString(16);
    }

    function clampInt(val, min, max, fallback) {
      const n = parseInt(val, 10);
      if (Number.isNaN(n)) return fallback;
      return Math.max(min, Math.min(max, n));
    }

    function normalizeName(name) {
      return String(name || "").trim().replace(/\s+/g, " ").toLowerCase();
    }

    function loadLocalAudienceState() {
      try {
        const raw = localStorage.getItem(LOCAL_AUDIENCE_KEY);
        if (!raw) return { isFollowing: false, localFollowers: 0 };
        const parsed = JSON.parse(raw);
        return {
          isFollowing: Boolean(parsed.isFollowing),
          localFollowers: clampInt(parsed.localFollowers, 0, 1000000, 0)
        };
      } catch {
        return { isFollowing: false, localFollowers: 0 };
      }
    }

    function saveLocalAudienceState() {
      try {
        localStorage.setItem(LOCAL_AUDIENCE_KEY, JSON.stringify(localAudienceState));
      } catch (err) {
        console.warn("تعذر حفظ حالة المتابع المحلية:", err);
      }
    }

    function createInitialState() {
      const totalPlayers = 15;
      const players = Array.from({ length: totalPlayers }, (_, i) => ({
        number: i + 1,
        name: "",
        status: "available",
        kills: 0,
        errors: 0,
        passes: 0
      }));

      return {
        revision: 1,
        contestClosed: false,
        settings: {
          killsToWin: 3,
          maxWinners: 3,
          totalPlayers: totalPlayers,
          cols: 5,
          maxErrors: 2,
          maxPasses: 1,
          timerSec: 30,
          orderedScreens: 2,
          adminPassHash: DEFAULT_ADMIN_PASS_HASH,
          cloudSyncUrl: ""
        },
        sheetsConfig: {
          url: "",
          range: "",
          intervalSec: 30,
          autoSync: false,
          lastSyncText: "لم يتم التزامن بعد"
        },
        players,
        questions: DEFAULT_QUESTIONS.map(q => ({ ...q })),
        usedQuestionIds: [],
        winners: [],
        logs: ["بدأت المسابقة بنجاح."],
        selectionMode: "random",
        currentSelector: null,
        currentTarget: null,
        activeQuestion: null,
        timeLeft: 30,
        timerRunning: false,
        answerRevealed: false
      };
    }

    function sanitizeState(rawObj) {
      const base = createInitialState();
      if (!rawObj || typeof rawObj !== "object") return base;

      const rawSettings = (rawObj.settings && typeof rawObj.settings === "object") ? rawObj.settings : {};
      const rawSheets = (rawObj.sheetsConfig && typeof rawObj.sheetsConfig === "object") ? rawObj.sheetsConfig : {};

      const totalPlayers = clampInt(rawSettings.totalPlayers, 2, 100, base.settings.totalPlayers);
      const maxWinners = clampInt(rawSettings.maxWinners, 1, totalPlayers, base.settings.maxWinners);
      const killsToWin = clampInt(rawSettings.killsToWin, 1, 50, base.settings.killsToWin);
      const cols = clampInt(rawSettings.cols, 2, 12, base.settings.cols);
      const maxErrors = clampInt(rawSettings.maxErrors, 1, 20, base.settings.maxErrors);
      const maxPasses = clampInt(rawSettings.maxPasses, 0, 20, base.settings.maxPasses);
      const timerSec = clampInt(rawSettings.timerSec, 5, 600, base.settings.timerSec);
      const orderedScreens = clampInt(rawSettings.orderedScreens, 1, 12, base.settings.orderedScreens);

      const adminPassHash =
        typeof rawSettings.adminPassHash === "string" && rawSettings.adminPassHash.trim()
          ? rawSettings.adminPassHash.trim()
          : base.settings.adminPassHash;

      let cloudSyncUrl = "";
      if (typeof rawSettings.cloudSyncUrl === "string" && rawSettings.cloudSyncUrl.trim()) {
        try {
          const u = new URL(rawSettings.cloudSyncUrl.trim());
          if (u.protocol === "https:" || u.protocol === "http:") {
            cloudSyncUrl = u.toString();
          }
        } catch {
          cloudSyncUrl = "";
        }
      }

      const rawPlayers = Array.isArray(rawObj.players) ? rawObj.players : [];
      const seenNames = new Set();
      const players = Array.from({ length: totalPlayers }, (_, idx) => {
        const p = rawPlayers[idx] && typeof rawPlayers[idx] === "object" ? rawPlayers[idx] : {};
        let cleanName = typeof p.name === "string" ? p.name.trim().slice(0, 80) : "";
        const norm = normalizeName(cleanName);
        if (norm) {
          if (seenNames.has(norm)) {
            cleanName = "";
          } else {
            seenNames.add(norm);
          }
        }
        let status = ["available", "eliminated", "winner"].includes(p.status) ? p.status : "available";
        return {
          number: idx + 1,
          name: cleanName,
          status,
          kills: clampInt(p.kills, 0, 999, 0),
          errors: clampInt(p.errors, 0, 999, 0),
          passes: clampInt(p.passes, 0, 999, 0)
        };
      });

      const rawQuestions = Array.isArray(rawObj.questions) ? rawObj.questions : base.questions;
      const questions = rawQuestions
        .filter(q => q && typeof q === "object" && typeof q.text === "string" && typeof q.answer === "string")
        .map((q, idx) => ({
          id: Number.isFinite(Number(q.id)) ? Number(q.id) : idx + 1,
          text: q.text.trim().slice(0, 500),
          answer: q.answer.trim().slice(0, 300),
          level: ["easy", "medium", "hard"].includes(q.level) ? q.level : "easy"
        }))
        .filter(q => q.text && q.answer);

      const validQIds = new Set(questions.map(q => q.id));
      const usedQuestionIds = Array.isArray(rawObj.usedQuestionIds)
        ? Array.from(new Set(rawObj.usedQuestionIds.map(Number).filter(id => validQIds.has(id))))
        : [];

      const validPlayerMap = new Map(players.map(p => [p.number, p]));
      const winners = [];
      if (Array.isArray(rawObj.winners)) {
        for (const w of rawObj.winners) {
          if (winners.length >= maxWinners) break;
          if (!w || typeof w !== "object") continue;
          const num = clampInt(w.number, 1, totalPlayers, -1);
          const pl = validPlayerMap.get(num);
          if (!pl) continue;
          if (winners.some(existing => existing.number === num)) continue;
          pl.status = "winner";
          winners.push({
            number: num,
            name: pl.name || `لاعب #${num}`,
            kills: clampInt(w.kills, 0, 999, pl.kills)
          });
        }
      }

      for (const pl of players) {
        if (pl.status === "winner" && !winners.some(w => w.number === pl.number)) {
          if (winners.length < maxWinners) {
            winners.push({
              number: pl.number,
              name: pl.name || `لاعب #${pl.number}`,
              kills: pl.kills
            });
          } else {
            pl.status = "available";
          }
        }
      }

      const contestClosed = Boolean(rawObj.contestClosed) || winners.length >= maxWinners;

      const currentSelector =
        rawObj.currentSelector !== null && rawObj.currentSelector !== undefined
          ? clampInt(rawObj.currentSelector, 1, totalPlayers, null)
          : null;
      const selectorObj = currentSelector ? validPlayerMap.get(currentSelector) : null;
      const safeSelector =
        selectorObj && selectorObj.status === "available"
          ? selectorObj.number
          : null;

      const currentTarget =
        rawObj.currentTarget !== null && rawObj.currentTarget !== undefined
          ? clampInt(rawObj.currentTarget, 1, totalPlayers, null)
          : null;
      const targetObj = currentTarget ? validPlayerMap.get(currentTarget) : null;
      const safeTarget =
        !contestClosed && targetObj && targetObj.status === "available"
          ? targetObj.number
          : null;

      let activeQuestion = null;
      if (!contestClosed && safeTarget && rawObj.activeQuestion && typeof rawObj.activeQuestion === "object") {
        const aq = rawObj.activeQuestion;
        if (typeof aq.text === "string" && typeof aq.answer === "string" && aq.text.trim() && aq.answer.trim()) {
          activeQuestion = {
            id: Number.isFinite(Number(aq.id)) ? Number(aq.id) : 0,
            text: aq.text.trim().slice(0, 500),
            answer: aq.answer.trim().slice(0, 300),
            level: ["easy", "medium", "hard"].includes(aq.level) ? aq.level : "easy"
          };
        }
      }

      const logs = Array.isArray(rawObj.logs)
        ? rawObj.logs.filter(l => typeof l === "string").map(l => l.slice(0, 300)).slice(0, 100)
        : base.logs;

      return {
        revision: clampInt(rawObj.revision, 1, 1000000000, 1),
        contestClosed,
        settings: {
          killsToWin,
          maxWinners,
          totalPlayers,
          cols,
          maxErrors,
          maxPasses,
          timerSec,
          orderedScreens,
          adminPassHash,
          cloudSyncUrl
        },
        sheetsConfig: {
          url: typeof rawSheets.url === "string" ? rawSheets.url.trim().slice(0, 500) : "",
          range: typeof rawSheets.range === "string" ? rawSheets.range.trim().slice(0, 100) : "",
          intervalSec: clampInt(rawSheets.intervalSec, 5, 3600, 30),
          autoSync: Boolean(rawSheets.autoSync),
          lastSyncText: typeof rawSheets.lastSyncText === "string" ? rawSheets.lastSyncText.slice(0, 120) : "لم يتم التزامن بعد"
        },
        players,
        questions: questions.length > 0 ? questions : base.questions,
        usedQuestionIds,
        winners,
        logs: logs.length > 0 ? logs : base.logs,
        selectionMode: rawObj.selectionMode === "manual" ? "manual" : "random",
        currentSelector: safeSelector,
        currentTarget: safeTarget,
        activeQuestion,
        timeLeft: activeQuestion ? clampInt(rawObj.timeLeft, 0, timerSec, timerSec) : timerSec,
        timerRunning: Boolean(activeQuestion && rawObj.timerRunning),
        answerRevealed: Boolean(activeQuestion && rawObj.answerRevealed)
      };
    }

    function loadState() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return createInitialState();
        return sanitizeState(JSON.parse(raw));
      } catch {
        return createInitialState();
      }
    }

    function saveState(broadcastMsg = null, bumpRevision = true) {
      if (bumpRevision) {
        state.revision = (Number(state.revision) || 0) + 1;
      }
      state = sanitizeState(state);
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      } catch (err) {
        console.warn("تعذر حفظ الحالة في localStorage:", err);
      }
      if (channel && broadcastMsg) {
        channel.postMessage({
          type: "STATE_UPDATE",
          revision: state.revision,
          msg: String(broadcastMsg).slice(0, 120),
          state
        });
      }
      if (isAdmin && state.settings.cloudSyncUrl) {
        pushToCloudSync(broadcastMsg || "update");
      }
    }

    function broadcastFullState(reason = "تحديث") {
      if (!isAdmin) return;
      addLog(`تمت مزامنة الحالة (${reason}).`);
      saveState(reason, true);
      renderAll();
    }

    async function pushToCloudSync(reason) {
      if (!isAdmin || !state.settings.cloudSyncUrl) return;
      try {
        await fetch(state.settings.cloudSyncUrl, {
          method: "POST",
          mode: "cors",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            reason: String(reason).slice(0, 120),
            revision: state.revision,
            timestamp: new Date().toISOString(),
            contestClosed: state.contestClosed,
            winnersCount: state.winners.length,
            playersCount: state.players.filter(p => p.name).length
          })
        });
      } catch (err) {
        console.warn("تعذر التحقق من نجاح المزامنة السحابية:", err);
      }
    }

    if (channel) {
      channel.onmessage = (event) => {
        const data = event.data;
        if (!data || typeof data !== "object" || data.type !== "STATE_UPDATE" || !data.state) return;
        const incoming = sanitizeState(data.state);
        if (incoming.revision < state.revision) return;
        state = incoming;
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
        } catch {}
        syncTimerWithState();
        renderAll();
      };
    }

    function pushHistory() {
      if (!isAdmin) return;
      historyStack.push(JSON.stringify(sanitizeState(state)));
      if (historyStack.length > 25) historyStack.shift();
      updateUndoButton();
    }

    function undoAction() {
      if (!isAdmin || historyStack.length === 0) return;
      try {
        const prevRaw = JSON.parse(historyStack.pop());
        state = sanitizeState(prevRaw);
        state.revision = (Number(state.revision) || 0) + 1;
        addLog("تم التراجع عن آخر إجراء.");
        saveState("تراجع عن آخر إجراء", false);
        syncTimerWithState();
        updateUndoButton();
        renderAll();
      } catch (err) {
        console.warn("تعذر استرجاع حالة التراجع:", err);
      }
    }

    function updateUndoButton() {
      const btn = document.getElementById("undoBtn");
      if (btn) btn.disabled = !isAdmin || historyStack.length === 0;
    }

    function addLog(text) {
      const time = new Date().toLocaleTimeString("ar-EG", { hour: "2-digit", minute: "2-digit", second: "2-digit" });
      state.logs.unshift(`[${time}] ${String(text || "").trim()}`);
      if (state.logs.length > 100) state.logs.pop();
    }

    function exportBackupJson() {
      if (!isAdmin) return;
      const safeBackup = {
        schemaVersion: 2,
        exportedAt: new Date().toISOString(),
        state: sanitizeState(state)
      };
      const blob = new Blob([JSON.stringify(safeBackup, null, 2)], { type: "application/json;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = `contest-backup-${Date.now()}.json`;
      a.click();
      URL.revokeObjectURL(url);
    }

    function importBackupFromFile(event) {
      if (!isAdmin) return;
      const file = event.target && event.target.files ? event.target.files[0] : null;
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (e) => {
        try {
          const parsed = JSON.parse(String(e.target.result || "{}"));
          const candidate = parsed && typeof parsed === "object" && parsed.state ? parsed.state : parsed;
          if (!candidate || typeof candidate !== "object") {
            alert("ملف النسخة الاحتياطية غير صالح.");
            return;
          }
          pushHistory();
          state = sanitizeState(candidate);
          state.revision = (Number(state.revision) || 0) + 1;
          addLog("تم استيراد نسخة احتياطية بعد التحقق من البنية والمقاييس.");
          saveState("استيراد نسخة احتياطية", false);
          syncTimerWithState();
          renderAll();
        } catch {
          alert("تعذر قراءة ملف JSON؛ تأكد من سلامة البنية.");
        } finally {
          event.target.value = "";
        }
      };
      reader.readAsText(file, "UTF-8");
    }

    function handleRoleButton() {
      if (isAdmin) {
        isAdmin = false;
        document.body.classList.add("viewer-mode");
        updateRoleUI();
        renderAll();
      } else {
        const input = document.getElementById("loginPassInput");
        const modal = document.getElementById("loginModal");
        if (input) input.value = "";
        if (modal) modal.classList.add("open");
        if (input) setTimeout(() => input.focus(), 50);
      }
    }

    function closeLoginModal() {
      const modal = document.getElementById("loginModal");
      if (modal) modal.classList.remove("open");
    }

    async function verifyAdminLogin() {
      const input = document.getElementById("loginPassInput");
      const pass = input ? input.value.trim() : "";
      if (!pass) return;
      const enteredHash = await sha256Hex(pass);
      if (enteredHash === state.settings.adminPassHash) {
        isAdmin = true;
        document.body.classList.remove("viewer-mode");
        closeLoginModal();
        updateRoleUI();
        renderAll();
      } else {
        alert("الرقم السري غير صحيح!");
      }
    }

    function updateRoleUI() {
      const badge = document.getElementById("roleBadge");
      const btn = document.getElementById("toggleRoleBtn");
      const devTag = document.getElementById("deviceRoleTag");
      if (isAdmin) {
        if (badge) {
          badge.textContent = "وضع المدير";
          badge.classList.remove("viewer");
        }
        if (btn) {
          btn.textContent = "🔒 خروج المدير";
          btn.className = "btn-ghost";
        }
        if (devTag) devTag.textContent = "جهاز تحكم المدير";
      } else {
        if (badge) {
          badge.textContent = "وضع الجمهور أولاً";
          badge.classList.add("viewer");
        }
        if (btn) {
          btn.textContent = "🔑 دخول المدير";
          btn.className = "btn-warning";
        }
        if (devTag) devTag.textContent = "جهاز مشاهدة";
      }
      updateUndoButton();
    }

    function toggleFollowContest() {
      if (!localAudienceState.isFollowing) {
        localAudienceState.isFollowing = true;
        localAudienceState.localFollowers += 1;
      } else {
        localAudienceState.isFollowing = false;
        localAudienceState.localFollowers = Math.max(0, localAudienceState.localFollowers - 1);
      }
      saveLocalAudienceState();
      renderStatsAndAudience();
    }

    function registerPlayer() {
      if (!isAdmin) return;
      const input = document.getElementById("playerNameInput");
      const name = input ? input.value.trim().replace(/\s+/g, " ") : "";
      if (!name) return;

      const normNew = normalizeName(name);
      const duplicate = state.players.find(p => p.name && normalizeName(p.name) === normNew);
      if (duplicate) {
        alert(`الاسم "${name}" مسجل مسبقاً للمتسابق رقم (${duplicate.number}). يرجى إدخال اسم مختلف.`);
        return;
      }

      let emptySlot = state.players.find(p => !p.name && p.status === "available");
      pushHistory();
      if (!emptySlot) {
        if (state.players.length >= 100) {
          alert("وصلت إلى الحد الأقصى (100 متسابق).");
          historyStack.pop();
          return;
        }
        emptySlot = { number: state.players.length + 1, name: "", status: "available", kills: 0, errors: 0, passes: 0 };
        state.players.push(emptySlot);
        state.settings.totalPlayers = state.players.length;
      }
      emptySlot.name = name;
      if (input) input.value = "";
      addLog(`تم تسجيل المتسابق رقم (${emptySlot.number}): ${name}`);
      saveState("تسجيل متسابق");
      renderAll();
    }

    function removeLastPlayer() {
      if (!isAdmin) return;
      const lastFilled = [...state.players].reverse().find(p => p.name);
      if (!lastFilled) return;

      const hasProgress = lastFilled.kills > 0 || lastFilled.errors > 0 || lastFilled.passes > 0 || lastFilled.status === "winner";
      const msg = hasProgress
        ? `تنبيه: المتسابق رقم (${lastFilled.number}) "${lastFilled.name}" لديه نقاط/حالة مسجلة (${lastFilled.status}). هل أنت متأكد من حذف تسجيله؟`
        : `هل أنت متأكد من حذف تسجيل المتسابق رقم (${lastFilled.number}): "${lastFilled.name}"؟`;

      if (!confirm(msg)) return;

      pushHistory();
      addLog(`تم حذف تسجيل المتسابق رقم (${lastFilled.number}): ${lastFilled.name}`);
      lastFilled.name = "";
      lastFilled.kills = 0;
      lastFilled.errors = 0;
      lastFilled.passes = 0;
      lastFilled.status = "available";
      state.winners = state.winners.filter(w => w.number !== lastFilled.number);
      if (state.winners.length < state.settings.maxWinners) {
        state.contestClosed = false;
      }
      if (state.currentSelector === lastFilled.number) state.currentSelector = null;
      if (state.currentTarget === lastFilled.number) {
        state.currentTarget = null;
        state.activeQuestion = null;
        state.timerRunning = false;
        stopTimer();
      }
      saveState("حذف آخر تسجيل");
      renderAll();
    }

    function parseCsvLine(line) {
      const result = [];
      let current = "";
      let inQuotes = false;
      for (let i = 0; i < line.length; i++) {
        const ch = line[i];
        if (ch === '"') {
          if (inQuotes && line[i + 1] === '"') {
            current += '"';
            i++;
          } else {
            inQuotes = !inQuotes;
          }
        } else if (ch === "," && !inQuotes) {
          result.push(current.trim());
          current = "";
        } else {
          current += ch;
        }
      }
      result.push(current.trim());
      return result;
    }

    function importNamesFromFile(event) {
      if (!isAdmin) return;
      const file = event.target && event.target.files ? event.target.files[0] : null;
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (e) => {
        const rawLines = String(e.target.result || "")
          .split(/\r?\n/)
          .flatMap(line => parseCsvLine(line))
          .map(s => s.trim().replace(/\s+/g, " "))
          .filter(Boolean);

        if (rawLines.length === 0) return;

        const uniqueNames = [];
        const seen = new Set();
        let skippedDupes = 0;
        for (const n of rawLines) {
          const key = normalizeName(n);
          if (!seen.has(key)) {
            seen.add(key);
            uniqueNames.push(n);
          } else {
            skippedDupes++;
          }
        }

        pushHistory();
        const replaceCheck = document.getElementById("replaceNamesCheck");
        const replace = Boolean(replaceCheck && replaceCheck.checked);

        if (replace) {
          state.players.forEach((p, idx) => {
            p.name = uniqueNames[idx] || "";
            p.status = "available";
            p.kills = 0;
            p.errors = 0;
            p.passes = 0;
          });
          state.winners = [];
          state.contestClosed = false;
        } else {
          const existingSeen = new Set(state.players.map(p => normalizeName(p.name)).filter(Boolean));
          let i = 0;
          for (const p of state.players) {
            if (!p.name) {
              while (i < uniqueNames.length && existingSeen.has(normalizeName(uniqueNames[i]))) {
                i++;
                skippedDupes++;
              }
              if (i < uniqueNames.length) {
                const chosenName = uniqueNames[i++];
                p.name = chosenName;
                existingSeen.add(normalizeName(chosenName));
              }
            }
          }
        }

        addLog(`تم استيراد ${uniqueNames.length} اسماً فريداً (تم تجاهل ${skippedDupes} مكرراً).`);
        saveState("استيراد أسماء");
        renderAll();
        event.target.value = "";
      };
      reader.readAsText(file, "UTF-8");
    }

    function readSheetsFormValues() {
      const urlEl = document.getElementById("sheetsUrlInput");
      const rangeEl = document.getElementById("sheetsRangeInput");
      const intervalEl = document.getElementById("sheetsIntervalInput");
      const autoEl = document.getElementById("sheetsAutoSyncCheck");
      return {
        url: urlEl ? urlEl.value.trim() : state.sheetsConfig.url,
        range: rangeEl ? rangeEl.value.trim() : state.sheetsConfig.range,
        intervalSec: clampInt(intervalEl ? intervalEl.value : state.sheetsConfig.intervalSec, 5, 3600, 30),
        autoSync: autoEl ? Boolean(autoEl.checked) : state.sheetsConfig.autoSync
      };
    }

    function saveGoogleSheetsConfig(notify = false) {
      if (!isAdmin) return;
      const cfg = readSheetsFormValues();
      state.sheetsConfig.url = cfg.url;
      state.sheetsConfig.range = cfg.range;
      state.sheetsConfig.intervalSec = cfg.intervalSec;
      state.sheetsConfig.autoSync = cfg.autoSync;
      saveState();
      toggleGoogleSheetsAutoSync(cfg);
      const statusEl = document.getElementById("sheetsSyncStatus");
      if (notify && statusEl) {
        statusEl.textContent = "تم حفظ إعدادات Google Sheets.";
      }
    }

    function buildSheetsCsvUrl(rawUrl, range) {
      let url = rawUrl.trim();
      const sheetMatch = url.match(/\/spreadsheets\/d\/([a-zA-Z0-9-_]+)/);
      if (sheetMatch && !url.includes("output=csv") && !url.includes("/gviz/tq")) {
        const id = sheetMatch[1];
        const gidMatch = url.match(/[#&?]gid=([0-9]+)/);
        const gidParam = gidMatch ? `&gid=${gidMatch[1]}` : "";
        const rangeParam = range ? `&range=${encodeURIComponent(range)}` : "";
        return `https://docs.google.com/spreadsheets/d/${id}/export?format=csv${gidParam}${rangeParam}`;
      }
      return url;
    }

    async function syncNamesFromGoogleSheets(silent = false) {
      if (!isAdmin) return;
      const cfg = readSheetsFormValues();
      state.sheetsConfig.url = cfg.url;
      state.sheetsConfig.range = cfg.range;
      state.sheetsConfig.intervalSec = cfg.intervalSec;
      state.sheetsConfig.autoSync = cfg.autoSync;
      toggleGoogleSheetsAutoSync(cfg);

      const statusEl = document.getElementById("sheetsSyncStatus");
      if (!cfg.url) {
        if (!silent && statusEl) statusEl.textContent = "يرجى إدخال رابط شيت جوجل أولاً.";
        return;
      }

      const fetchUrl = buildSheetsCsvUrl(cfg.url, cfg.range);
      if (!silent && statusEl) statusEl.textContent = "جاري جلب الأسماء...";

      try {
        const res = await fetch(fetchUrl);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const text = await res.text();

        let rawNames = [];
        const trimmed = text.trim();
        if (trimmed.startsWith("{") || trimmed.startsWith("[")) {
          const json = JSON.parse(trimmed);
          const rows = Array.isArray(json) ? json : (json.names || json.values || json.data || []);
          rawNames = rows.flat().map(v => String(v || "").trim()).filter(Boolean);
        } else {
          rawNames = trimmed
            .split(/\r?\n/)
            .map(line => (parseCsvLine(line)[0] || "").trim())
            .filter(Boolean);
        }

        const uniqueNames = [];
        const seen = new Set();
        for (const n of rawNames) {
          const key = normalizeName(n);
          if (!seen.has(key)) {
            seen.add(key);
            uniqueNames.push(n);
          }
        }

        if (uniqueNames.length === 0) throw new Error("لم يتم العثور على أسماء صالحة");

        pushHistory();
        state.players.forEach((p, idx) => {
          if (idx < uniqueNames.length) {
            p.name = uniqueNames[idx];
          }
        });

        const nowStr = new Date().toLocaleTimeString("ar-EG");
        state.sheetsConfig.lastSyncText = `تمت مزامنة ${uniqueNames.length} اسماً (${nowStr})`;
        if (statusEl) statusEl.textContent = state.sheetsConfig.lastSyncText;
        addLog(state.sheetsConfig.lastSyncText);
        saveState("مزامنة الأسماء من Google Sheets");
        renderAll();
      } catch (err) {
        const msg = `تعذر التزامن المباشر (تحقق من صلاحية المشاركة أو CORS أو نشر الشيت): ${err.message}`;
        if (statusEl) statusEl.textContent = msg;
        if (!silent) console.warn(msg);
      }
    }

    function toggleGoogleSheetsAutoSync(overrideCfg = null) {
      if (sheetsSyncTimer) {
        clearInterval(sheetsSyncTimer);
        sheetsSyncTimer = null;
      }
      const cfg = overrideCfg || readSheetsFormValues();
      state.sheetsConfig.autoSync = Boolean(cfg.autoSync);
      state.sheetsConfig.intervalSec = clampInt(cfg.intervalSec, 5, 3600, 30);
      if (isAdmin && state.sheetsConfig.autoSync && state.sheetsConfig.url) {
        sheetsSyncTimer = setInterval(() => syncNamesFromGoogleSheets(true), state.sheetsConfig.intervalSec * 1000);
      }
    }

    function ensureValidSelector() {
      if (!state.currentSelector) return null;
      const sel = state.players.find(p => p.number === state.currentSelector);
      if (!sel || sel.status !== "available") {
        const fallback = state.players.find(p => p.status === "available");
        state.currentSelector = fallback ? fallback.number : null;
      }
      return state.currentSelector;
    }

    function changeSelectionMode() {
      if (!isAdmin) return;
      const selEl = document.getElementById("selectionModeSelect");
      state.selectionMode = selEl && selEl.value === "manual" ? "manual" : "random";
      saveState("تغيير نمط اختيار الخصم");
      renderStage();
      renderPlayersGrid();
    }

    function pickRandomTarget() {
      if (!isAdmin) return;
      if (state.contestClosed || state.winners.length >= state.settings.maxWinners) {
        state.contestClosed = true;
        alert("اكتمل عدد الفائزين المحدد وتم إغلاق المسابقة.");
        return;
      }
      const available = state.players.filter(p => p.status === "available");
      if (available.length === 0) {
        alert("لا يوجد متسابقون متاحون حالياً!");
        return;
      }
      pushHistory();
      const activeSel = ensureValidSelector();
      const candidates = available.length > 1 && activeSel
        ? available.filter(p => p.number !== activeSel)
        : available;
      const chosen = candidates[Math.floor(Math.random() * candidates.length)];
      state.currentTarget = chosen.number;
      if (!activeSel) {
        state.currentSelector = chosen.number;
      }
      assignQuestionForTarget(chosen.number);
    }

    function handlePlayerTileClick(num) {
      if (!isAdmin) return;
      if (state.contestClosed || state.winners.length >= state.settings.maxWinners) {
        state.contestClosed = true;
        return;
      }
      const player = state.players.find(p => p.number === num);
      if (!player || player.status !== "available") return;

      ensureValidSelector();

      if (state.selectionMode === "manual") {
        pushHistory();
        if (!state.currentSelector || state.currentSelector === num) {
          state.currentSelector = num;
          addLog(`تم تعيين اللاعب رقم (${num}) كمختار.`);
          saveState("تحديد المختار يدوياً");
          renderAll();
        } else {
          state.currentTarget = num;
          assignQuestionForTarget(num);
        }
      } else {
        pushHistory();
        state.currentTarget = num;
        if (!state.currentSelector) state.currentSelector = num;
        assignQuestionForTarget(num);
      }
    }

    function assignQuestionForTarget(targetNum) {
      if (state.contestClosed) return;
      const levelEl = document.getElementById("levelSelector");
      const levelFilter = levelEl ? levelEl.value : "all";
      let pool = state.questions.filter(q => !state.usedQuestionIds.includes(q.id));
      if (pool.length === 0) {
        state.usedQuestionIds = [];
        pool = [...state.questions];
      }
      if (levelFilter !== "all") {
        const filtered = pool.filter(q => q.level === levelFilter);
        if (filtered.length > 0) pool = filtered;
      }
      const q = pool[Math.floor(Math.random() * pool.length)];
      state.activeQuestion = { ...q };
      if (!state.usedQuestionIds.includes(q.id)) {
        state.usedQuestionIds.push(q.id);
      }
      state.answerRevealed = false;
      state.timeLeft = state.settings.timerSec;
      state.timerRunning = true;
      timerRemainingAtPause = null;
      timerEndPerf = performance.now() + state.timeLeft * 1000;

      addLog(`طُرح سؤال على المتسابق رقم (${targetNum}).`);
      saveState("طرح سؤال جديد");
      startTimer();
      renderAll();
    }

    function revealAnswer() {
      if (!state.activeQuestion) return;
      state.answerRevealed = !state.answerRevealed;
      const box = document.getElementById("answerBox");
      if (box) box.classList.toggle("visible", state.answerRevealed);
    }

    function handleAnswer(isCorrect) {
      if (!isAdmin || !state.currentTarget || state.contestClosed) return;
      stopTimer();
      pushHistory();

      const target = state.players.find(p => p.number === state.currentTarget);
      const activeSelNum = ensureValidSelector();
      const selector = activeSelNum ? state.players.find(p => p.number === activeSelNum) : null;

      if (isCorrect) {
        if (selector && target && selector.number !== target.number && selector.status === "available") {
          selector.kills += 1;
          addLog(`إجابة صحيحة من (${target.number}) لصالح المختار (${selector.number}) - الإسقاطات: ${selector.kills}/${state.settings.killsToWin}`);
          checkWinner(selector);
        } else if (target && target.status === "available") {
          target.kills += 1;
          addLog(`إجابة صحيحة للمتسابق رقم (${target.number}) - الإسقاطات: ${target.kills}/${state.settings.killsToWin}`);
          checkWinner(target);
        }

        if (!state.contestClosed && target && target.status === "available") {
          state.currentSelector = target.number;
        } else if (!state.contestClosed) {
          ensureValidSelector();
        }
      } else {
        if (target && target.status === "available") {
          target.errors += 1;
          addLog(`إجابة خاطئة من المتسابق رقم (${target.number}) - الأخطاء: ${target.errors}/${state.settings.maxErrors}`);
          triggerShake();
          if (target.errors >= state.settings.maxErrors) {
            target.status = "eliminated";
            addLog(`خروج المتسابق رقم (${target.number}) بسبب تجاوز الحد المسموح من الأخطاء.`);
            if (state.currentSelector === target.number) {
              ensureValidSelector();
            }
          }
        }
      }

      state.currentTarget = null;
      state.activeQuestion = null;
      state.answerRevealed = false;
      state.timerRunning = false;
      timerEndPerf = null;
      timerRemainingAtPause = null;
      saveState(isCorrect ? "إجابة صحيحة" : "إجابة خاطئة");
      renderAll();
    }

    function handlePass() {
      if (!isAdmin || !state.currentTarget || state.contestClosed) return;
      stopTimer();
      pushHistory();
      const target = state.players.find(p => p.number === state.currentTarget);
      if (target && target.status === "available") {
        target.passes += 1;
        addLog(`اعتذار / تمرير من المتسابق رقم (${target.number}) (${target.passes}/${state.settings.maxPasses}).`);
        if (target.passes > state.settings.maxPasses) {
          target.status = "eliminated";
          addLog(`استبعاد المتسابق رقم (${target.number}) لتجاوز عدد الاعتذارات المسموح.`);
          triggerShake();
          if (state.currentSelector === target.number) {
            ensureValidSelector();
          }
        }
      }
      state.currentTarget = null;
      state.activeQuestion = null;
      state.answerRevealed = false;
      state.timerRunning = false;
      timerEndPerf = null;
      timerRemainingAtPause = null;
      saveState("اعتذار / تمرير");
      renderAll();
    }

    function checkWinner(player) {
      if (!player || player.status === "winner" || state.contestClosed) return;
      if (state.winners.length >= state.settings.maxWinners) {
        state.contestClosed = true;
        return;
      }
      if (player.kills >= state.settings.killsToWin) {
        player.status = "winner";
        state.winners.push({
          number: player.number,
          name: player.name || `لاعب #${player.number}`,
          kills: player.kills
        });
        addLog(`🏆 فوز المتسابق رقم (${player.number}) ${player.name || ""} بالمركز #${state.winners.length}!`);
        launchConfetti();

        if (state.winners.length >= state.settings.maxWinners) {
          state.contestClosed = true;
          state.currentTarget = null;
          state.currentSelector = null;
          state.activeQuestion = null;
          state.timerRunning = false;
          stopTimer();
          addLog("🔒 اكتمل العدد الأقصى للفائزين وتم إغلاق المسابقة بالكامل.");
        }
      }
    }

    function syncTimerWithState() {
      stopTimer();
      if (state.activeQuestion && state.timerRunning && state.timeLeft > 0) {
        timerEndPerf = performance.now() + state.timeLeft * 1000;
        startTimer();
      } else if (state.activeQuestion && !state.timerRunning) {
        timerRemainingAtPause = state.timeLeft;
        timerEndPerf = null;
      } else {
        timerEndPerf = null;
        timerRemainingAtPause = null;
      }
    }

    function startTimer() {
      stopTimer();
      if (!state.timerRunning || !state.activeQuestion) return;
      if (!timerEndPerf) {
        timerEndPerf = performance.now() + Math.max(0, state.timeLeft) * 1000;
      }
      timerInterval = setInterval(() => {
        if (!state.timerRunning || !timerEndPerf) return;
        const remainingSec = Math.max(0, Math.ceil((timerEndPerf - performance.now()) / 1000));
        const changed = remainingSec !== state.timeLeft;
        state.timeLeft = remainingSec;

        if (remainingSec <= 0) {
          state.timeLeft = 0;
          state.timerRunning = false;
          timerEndPerf = null;
          stopTimer();
          renderTimerOnly();
          if (isAdmin) {
            addLog(`انتهى وقت السؤال للمتسابق رقم (${state.currentTarget ?? "-"}).`);
            saveState("انقضاء وقت المؤقت");
          } else {
            try {
              localStorage.setItem(STORAGE_KEY, JSON.stringify(sanitizeState(state)));
            } catch {}
          }
          return;
        }

        if (changed) {
          renderTimerOnly();
        }
      }, 200);
    }

    function stopTimer() {
      if (timerInterval) {
        clearInterval(timerInterval);
        timerInterval = null;
      }
    }

    function toggleTimer() {
      if (!isAdmin || !state.activeQuestion || state.contestClosed) return;
      if (state.timerRunning) {
        if (timerEndPerf) {
          state.timeLeft = Math.max(0, Math.ceil((timerEndPerf - performance.now()) / 1000));
        }
        timerRemainingAtPause = state.timeLeft;
        state.timerRunning = false;
        timerEndPerf = null;
        stopTimer();
        saveState("إيقاف المؤقت مؤقتاً");
      } else {
        const resumeSec = timerRemainingAtPause !== null ? timerRemainingAtPause : state.timeLeft;
        if (resumeSec <= 0) return;
        state.timeLeft = resumeSec;
        state.timerRunning = true;
        timerRemainingAtPause = null;
        timerEndPerf = performance.now() + resumeSec * 1000;
        startTimer();
        saveState("استئناف المؤقت");
      }
      renderTimerOnly();
    }

    function renderTimerOnly() {
      const el = document.getElementById("timerDisplay");
      const btn = document.getElementById("timerToggleBtn");
      if (!el) return;
      el.textContent = String(state.timeLeft);
      el.classList.toggle("urgent", state.timeLeft <= 5 && state.timeLeft > 0);
      if (btn) btn.textContent = state.timerRunning ? "⏸️" : "▶️";
    }

    function triggerShake() {
      document.body.classList.remove("shake-effect");
      void document.body.offsetWidth;
      document.body.classList.add("shake-effect");
    }

    function launchConfetti() {
      const canvas = document.getElementById("confettiCanvas");
      if (!canvas) return;
      const ctx = canvas.getContext("2d");
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
      const colors = ["#eab308", "#3b82f6", "#10b981", "#f43f5e", "#a855f7"];
      const pieces = Array.from({ length: 110 }, () => ({
        x: Math.random() * canvas.width,
        y: Math.random() * -canvas.height,
        w: 7 + Math.random() * 6,
        h: 4 + Math.random() * 5,
        vy: 2.5 + Math.random() * 4,
        vx: -2 + Math.random() * 4,
        color: colors[Math.floor(Math.random() * colors.length)],
        rot: Math.random() * 360
      }));
      let frames = 0;
      function draw() {
        frames++;
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        pieces.forEach(p => {
          p.x += p.vx;
          p.y += p.vy;
          p.rot += 5;
          ctx.save();
          ctx.translate(p.x, p.y);
          ctx.rotate((p.rot * Math.PI) / 180);
          ctx.fillStyle = p.color;
          ctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
          ctx.restore();
        });
        if (frames < 140) requestAnimationFrame(draw);
        else ctx.clearRect(0, 0, canvas.width, canvas.height);
      }
      draw();
    }

    function openDisplayWindow(screenNum = 1) {
      const safeNum = clampInt(screenNum, 1, 12, 1);
      const url = `${window.location.href.split("#")[0]}#screen=${safeNum}`;
      window.open(url, `contest_screen_${safeNum}`, "noopener,noreferrer");
    }

    function updateOrderedScreensCount() {
      if (!isAdmin) return;
      const input = document.getElementById("orderedScreensInput");
      const val = clampInt(input ? input.value : state.settings.orderedScreens, 1, 12, 1);
      pushHistory();
      state.settings.orderedScreens = val;
      saveState("تحديث عدد الشاشات المرتبة");
      renderOrderedScreens();
    }

    function openAllOrderedScreens() {
      for (let i = 1; i <= state.settings.orderedScreens; i++) {
        openDisplayWindow(i);
      }
    }

    function renderOrderedScreens() {
      const container = document.getElementById("orderedScreensList");
      const input = document.getElementById("orderedScreensInput");
      if (!container) return;
      if (input) input.value = String(state.settings.orderedScreens);
      container.textContent = "";

      for (let i = 1; i <= state.settings.orderedScreens; i++) {
        const div = document.createElement("div");
        div.className = "screen-card";

        const infoWrap = document.createElement("div");
        const titleEl = document.createElement("strong");
        titleEl.textContent = `شاشة عرض #${i}`;
        const statusSpan = document.createElement("span");
        statusSpan.className = "screen-status online";
        statusSpan.style.marginRight = "6px";
        statusSpan.textContent = "● جاهزة";
        infoWrap.appendChild(titleEl);
        infoWrap.appendChild(statusSpan);

        const openBtn = document.createElement("button");
        openBtn.className = "btn-cyan";
        openBtn.style.padding = "5px 10px";
        openBtn.style.fontSize = "0.78rem";
        openBtn.textContent = "فتح";
        openBtn.addEventListener("click", () => openDisplayWindow(i));

        div.appendChild(infoWrap);
        div.appendChild(openBtn);
        container.appendChild(div);
      }
    }

    function setFieldValue(id, value) {
      const el = document.getElementById(id);
      if (el) el.value = String(value);
    }

    function openSettings() {
      if (!isAdmin) return;
      setFieldValue("cfgKillsToWin", state.settings.killsToWin);
      setFieldValue("cfgMaxWinners", state.settings.maxWinners);
      setFieldValue("cfgTotalPlayers", state.settings.totalPlayers);
      setFieldValue("cfgCols", state.settings.cols);
      setFieldValue("cfgMaxErrors", state.settings.maxErrors);
      setFieldValue("cfgMaxPasses", state.settings.maxPasses);
      setFieldValue("cfgTimerSec", state.settings.timerSec);
      setFieldValue("cfgOrderedScreens", state.settings.orderedScreens);
      setFieldValue("cfgCloudSyncUrl", state.settings.cloudSyncUrl || "");
      renderArchiveList();
      const modal = document.getElementById("settingsModal");
      if (modal) modal.classList.add("open");
    }

    function closeSettings() {
      const modal = document.getElementById("settingsModal");
      if (modal) modal.classList.remove("open");
    }

    function saveSettings() {
      if (!isAdmin) return;
      const rawTotal = parseInt(document.getElementById("cfgTotalPlayers")?.value, 10);
      const newTotal = clampInt(rawTotal, 2, 100, state.settings.totalPlayers);

      if (newTotal < state.players.length) {
        const removedPlayers = state.players.slice(newTotal);
        const hasImportantData = removedPlayers.some(
          p => p.name || p.kills > 0 || p.errors > 0 || p.passes > 0 || p.status === "winner"
        );
        if (hasImportantData) {
          const ok = confirm(
            `تقليل عدد اللاعبين من ${state.players.length} إلى ${newTotal} سيحذف بيانات ${removedPlayers.length} لاعباً (بما فيهم المسجلون أو الفائزون). هل تريد المتابعة؟`
          );
          if (!ok) return;
        }
      }

      pushHistory();
      const newMaxWinners = clampInt(document.getElementById("cfgMaxWinners")?.value, 1, newTotal, state.settings.maxWinners);
      state.settings.killsToWin = clampInt(document.getElementById("cfgKillsToWin")?.value, 1, 50, state.settings.killsToWin);
      state.settings.maxWinners = newMaxWinners;
      state.settings.cols = clampInt(document.getElementById("cfgCols")?.value, 2, 12, state.settings.cols);
      state.settings.maxErrors = clampInt(document.getElementById("cfgMaxErrors")?.value, 1, 20, state.settings.maxErrors);
      state.settings.maxPasses = clampInt(document.getElementById("cfgMaxPasses")?.value, 0, 20, state.settings.maxPasses);
      state.settings.timerSec = clampInt(document.getElementById("cfgTimerSec")?.value, 5, 600, state.settings.timerSec);
      state.settings.orderedScreens = clampInt(document.getElementById("cfgOrderedScreens")?.value, 1, 12, state.settings.orderedScreens);

      const cloudInputVal = (document.getElementById("cfgCloudSyncUrl")?.value || "").trim();
      if (!cloudInputVal) {
        state.settings.cloudSyncUrl = "";
      } else {
        try {
          const u = new URL(cloudInputVal);
          state.settings.cloudSyncUrl = (u.protocol === "https:" || u.protocol === "http:") ? u.toString() : "";
        } catch {
          alert("رابط المزامنة السحابية غير صالح؛ تم تجاهله.");
        }
      }

      if (newTotal > state.players.length) {
        for (let i = state.players.length + 1; i <= newTotal; i++) {
          state.players.push({ number: i, name: "", status: "available", kills: 0, errors: 0, passes: 0 });
        }
      } else if (newTotal < state.players.length) {
        state.players = state.players.slice(0, newTotal);
      }
      state.settings.totalPlayers = newTotal;

      const validNumbers = new Set(state.players.map(p => p.number));
      state.winners = state.winners
        .filter(w => validNumbers.has(w.number))
        .slice(0, state.settings.maxWinners);
      const winnerSet = new Set(state.winners.map(w => w.number));
      state.players.forEach(p => {
        if (p.status === "winner" && !winnerSet.has(p.number)) {
          p.status = "available";
        }
      });
      state.contestClosed = state.winners.length >= state.settings.maxWinners;
      if (state.contestClosed) {
        state.currentTarget = null;
        state.activeQuestion = null;
        state.timerRunning = false;
        stopTimer();
      }

      addLog("تم حفظ وتطبيق إعدادات المسابقة الجديدة.");
      saveState("تحديث الإعدادات");
      closeSettings();
      renderAll();
    }

    async function changePassword() {
      if (!isAdmin) return;
      const passInput = document.getElementById("newAdminPass");
      const np = passInput ? passInput.value.trim() : "";
      if (!np || np.length < 4) {
        alert("يرجى إدخال رقم سري لا يقل عن 4 خانات.");
        return;
      }
      state.settings.adminPassHash = await sha256Hex(np);
      if (passInput) passInput.value = "";
      saveState();
      alert("تم تحديث الرقم السري للمدير بنجاح.");
    }

    function addQuestionToArchive() {
      if (!isAdmin) return;
      const textEl = document.getElementById("newQText");
      const ansEl = document.getElementById("newQAnswer");
      const lvlEl = document.getElementById("newQLevel");
      const text = textEl ? textEl.value.trim() : "";
      const answer = ansEl ? ansEl.value.trim() : "";
      const level = lvlEl && ["easy", "medium", "hard"].includes(lvlEl.value) ? lvlEl.value : "easy";
      if (!text || !answer) return;

      pushHistory();
      const nextId = state.questions.reduce((max, q) => Math.max(max, Number(q.id) || 0), 0) + 1;
      state.questions.push({ id: nextId, text, answer, level });
      if (textEl) textEl.value = "";
      if (ansEl) ansEl.value = "";
      addLog(`تمت إضافة سؤال جديد إلى الأرشيف (${level}).`);
      saveState("إضافة سؤال للأرشيف");
      renderArchiveList();
      renderStatsAndAudience();
    }

    function deleteQuestionFromArchive(id) {
      if (!isAdmin) return;
      pushHistory();
      state.questions = state.questions.filter(q => q.id !== id);
      state.usedQuestionIds = state.usedQuestionIds.filter(qid => qid !== id);
      saveState("حذف سؤال من الأرشيف");
      renderArchiveList();
      renderStatsAndAudience();
    }

    function renderArchiveList() {
      const filterEl = document.getElementById("archiveFilterSelect");
      const filter = filterEl ? filterEl.value : "all";
      const container = document.getElementById("archiveListContainer");
      const countEl = document.getElementById("archiveTotalCount");
      if (!container) return;
      if (countEl) countEl.textContent = String(state.questions.length);

      container.textContent = "";
      const list = filter === "all" ? state.questions : state.questions.filter(q => q.level === filter);

      list.forEach(q => {
        const item = document.createElement("div");
        item.className = "archive-item";

        const info = document.createElement("div");
        const qTitle = document.createElement("strong");
        qTitle.textContent = q.text;
        const meta = document.createElement("div");
        meta.style.fontSize = "0.78rem";
        meta.style.color = "var(--text-muted)";
        meta.textContent = `الإجابة: ${q.answer} | المستوى: ${q.level}`;
        info.appendChild(qTitle);
        info.appendChild(meta);

        const delBtn = document.createElement("button");
        delBtn.className = "btn-danger";
        delBtn.style.padding = "4px 8px";
        delBtn.style.fontSize = "0.75rem";
        delBtn.textContent = "حذف";
        delBtn.addEventListener("click", () => deleteQuestionFromArchive(q.id));

        item.appendChild(info);
        item.appendChild(delBtn);
        container.appendChild(item);
      });
    }

    function renderStatsAndAudience() {
      const followersEl = document.getElementById("followersCount");
      const followBtn = document.getElementById("followBtn");
      if (followersEl) followersEl.textContent = String(localAudienceState.localFollowers);
      if (followBtn) {
        followBtn.textContent = localAudienceState.isFollowing ? "✓ متابَع (محلي)" : "➕ متابعة";
      }

      const totalEl = document.getElementById("statTotalPlayers");
      const availEl = document.getElementById("statAvailablePlayers");
      const elimEl = document.getElementById("statEliminatedPlayers");
      const winEl = document.getElementById("statWinnersCount");

      const availableCount = state.players.filter(p => p.status === "available").length;
      const eliminatedCount = state.players.filter(p => p.status === "eliminated").length;

      if (totalEl) totalEl.textContent = String(state.players.length);
      if (availEl) availEl.textContent = String(availableCount);
      if (elimEl) elimEl.textContent = String(eliminatedCount);
      if (winEl) winEl.textContent = `${state.winners.length}/${state.settings.maxWinners}`;

      const logsEl = document.getElementById("logsContainer");
      if (logsEl) {
        logsEl.textContent = "";
        state.logs.forEach(entry => {
          const div = document.createElement("div");
          div.className = "log-entry";
          div.textContent = entry;
          logsEl.appendChild(div);
        });
      }
    }

    function renderPlayersGrid() {
      const grid = document.getElementById("playersGrid");
      if (!grid) return;
      grid.style.gridTemplateColumns = `repeat(${state.settings.cols}, minmax(0, 1fr))`;
      grid.textContent = "";

      state.players.forEach(p => {
        const tile = document.createElement("div");
        tile.className = `player-tile status-${p.status}`;
        if (state.currentSelector === p.number) tile.classList.add("is-selector");
        if (state.currentTarget === p.number) tile.classList.add("is-target");

        const numEl = document.createElement("div");
        numEl.className = "player-num";
        numEl.textContent = `#${p.number}`;

        const nameEl = document.createElement("div");
        nameEl.className = "player-name";
        nameEl.textContent = p.name || `لاعب #${p.number}`;

        const metaEl = document.createElement("div");
        metaEl.className = "player-meta";
        metaEl.textContent = `✓${p.kills} | ✕${p.errors} | ↷${p.passes}`;

        tile.appendChild(numEl);
        tile.appendChild(nameEl);
        tile.appendChild(metaEl);

        if (isAdmin && p.status === "available" && !state.contestClosed) {
          tile.style.cursor = "pointer";
          tile.addEventListener("click", () => handlePlayerTileClick(p.number));
        }

        grid.appendChild(tile);
      });
    }

    function renderStage() {
      const modeSelect = document.getElementById("selectionModeSelect");
      if (modeSelect) modeSelect.value = state.selectionMode;

      const selBox = document.getElementById("currentSelectorLabel");
      const tgtBox = document.getElementById("currentTargetLabel");
      const qTextEl = document.getElementById("activeQuestionText");
      const ansTextEl = document.getElementById("activeAnswerText");
      const ansBox = document.getElementById("answerBox");

      const selectorObj = state.players.find(p => p.number === state.currentSelector);
      const targetObj = state.players.find(p => p.number === state.currentTarget);

      if (selBox) {
        selBox.textContent = selectorObj
          ? `#${selectorObj.number} - ${selectorObj.name || "لاعب"}`
          : state.contestClosed ? "المسابقة مغلقة" : "غير محدد";
      }

      if (tgtBox) {
        tgtBox.textContent = targetObj
          ? `#${targetObj.number} - ${targetObj.name || "لاعب"}`
          : state.contestClosed ? "اكتمل الفائزون" : "بانتظار الاختيار";
      }

      if (qTextEl) {
        if (state.contestClosed) {
          qTextEl.textContent = `تم إغلاق المسابقة بعد وصول عدد الفائزين إلى (${state.winners.length}/${state.settings.maxWinners}).`;
        } else if (state.activeQuestion) {
          qTextEl.textContent = state.activeQuestion.text;
        } else {
          qTextEl.textContent = "لا يوجد سؤال نشط حالياً.";
        }
      }

      if (ansTextEl) {
        ansTextEl.textContent = state.activeQuestion ? state.activeQuestion.answer : "";
      }
      if (ansBox) {
        ansBox.classList.toggle("visible", Boolean(state.activeQuestion && state.answerRevealed));
      }

      renderTimerOnly();
    }

    function renderWinnersBoard() {
      const board = document.getElementById("winnersBoard");
      if (!board) return;
      board.textContent = "";

      for (let i = 0; i < state.settings.maxWinners; i++) {
        const w = state.winners[i];
        const card = document.createElement("div");
        card.className = `winner-slot ${w ? "filled" : ""}`;

        const rank = document.createElement("span");
        rank.className = "winner-rank";
        rank.textContent = `المركز #${i + 1}`;

        const label = document.createElement("span");
        label.className = "winner-name";
        label.textContent = w ? `${w.name} (#${w.number}) — ${w.kills} إسقاطات` : "شاغر";

        card.appendChild(rank);
        card.appendChild(label);
        board.appendChild(card);
      }
    }

    function applyScreenHashLabel() {
      const match = window.location.hash.match(/screen=(\d+)/i);
      const tag = document.getElementById("screenTitleTag");
      if (match && tag) {
        const num = clampInt(match[1], 1, 12, 1);
        tag.textContent = `شاشة عرض المسابقة #${num}`;
      }
    }

    function renderAll() {
      applyScreenHashLabel();
      updateRoleUI();
      renderStatsAndAudience();
      renderPlayersGrid();
      renderStage();
      renderWinnersBoard();
      renderOrderedScreens();
    }

    if (!isAdmin) {
      document.body.classList.add("viewer-mode");
    }
    syncTimerWithState();
    renderAll();
  </script>
</body>
</html>
